{
    "manifestVersion": 1,
    "id": "dorc-release-task",
    "name": "Dorc Release Tools",
    "version": "3.3.0",
    "publisher": "SEFE",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],    
    "description": "Tools for releasing with Dorc.",
    "categories": [
        "Azure Pipelines"
    ],
    "icons": {
        "default": "images/extension-icon.png"        
    },
    "files": [
        {
            "path": "DorcRequest"
        }
    ],
    "contributions": [
        {
            "id": "custom-build-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "DorcRequest"
            }
        }
    ]
}
